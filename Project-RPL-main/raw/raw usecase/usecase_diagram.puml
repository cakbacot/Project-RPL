@startuml
left to right direction
skinparam packageStyle rectangle

actor "Pengguna (User)" as User

rectangle "Sistem Informasi KuroFin" {
    
    package "Manajemen Transaksi" {
        usecase "Mencatat Transaksi Baru" as UC_AddTx
        usecase "Melihat Riwayat Transaksi" as UC_ViewTx
        usecase "Mengubah Data Transaksi" as UC_EditTx
        usecase "Menghapus Data Transaksi" as UC_DeleteTx
        usecase "Melihat Dashboard & Saldo" as UC_Dashboard
        usecase "Validasi Input & Kategori" as UC_Validate
        usecase "Pembaruan Saldo Otomatis" as UC_UpdateBalance
    }

    package "Manajemen Kategori" {
        usecase "Menambah Kategori" as UC_AddCat
        usecase "Mengubah Kategori" as UC_EditCat
        usecase "Menghapus Kategori" as UC_DeleteCat
    }

    package "Batas Pengeluaran & Notifikasi" {
        usecase "Mengatur Batas Pengeluaran" as UC_SetBudget
        usecase "Memperbarui atau Hapus Batas" as UC_ManageBudget
        usecase "Menampilkan Notifikasi Budget Alert" as UC_Alert
    }

    package "Laporan Keuangan" {
        usecase "Melihat Laporan Keuangan" as UC_ViewReport
        usecase "Melihat Grafik Tren Keuangan" as UC_ViewChart
        usecase "Mengekspor Laporan (PDF/CSV)" as UC_ExportReport
    }

    package "Manajemen Basis Data" {
        usecase "Backup Basis Data Lokal" as UC_Backup
        usecase "Restore Basis Data Lokal" as UC_Restore
    }
}

User --> UC_Dashboard
User --> UC_ViewTx
User --> UC_AddTx
User --> UC_EditTx
User --> UC_DeleteTx

User --> UC_AddCat
User --> UC_EditCat
User --> UC_DeleteCat

User --> UC_SetBudget
User --> UC_ManageBudget

User --> UC_ViewReport
User --> UC_ViewChart

User --> UC_Backup
User --> UC_Restore

UC_AddTx ..> UC_Validate : <<include>>
UC_AddTx ..> UC_UpdateBalance : <<include>>
UC_EditTx ..> UC_UpdateBalance : <<include>>
UC_DeleteTx ..> UC_UpdateBalance : <<include>>

UC_Alert ..> UC_AddTx : <<extend>>
UC_ExportReport ..> UC_ViewReport : <<extend>>

@enduml